# ---- обязательно ----
DOMAIN=admin.example.com
APP_URL=https://admin.example.com
POSTGRES_PASSWORD=change-me-long-random
# для локальной разработки без Docker:
# DATABASE_URL=postgresql://smm:smm@localhost:5432/smm
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32 — шифрует токены соцсетей, не менять после подключения аккаунтов
ENCRYPTION_KEY=
BASE_TIMEZONE=America/Winnipeg

# ---- каталог B2 ----
# Вариант 1: публичная страница-каталог с реестром файлов (ключ не нужен)
B2_REGISTRY_URL=
# Вариант 2: приватный бакет по S3 API (ключ только listFiles + readFiles)
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
B2_PREFIX=originals/
SYNC_INTERVAL_MIN=15

# ---- YouTube (Google Cloud → OAuth client «Web application») ----
# Redirect URI: https://<домен>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Instagram (Meta app → Instagram API with Instagram Login) ----
# Redirect URI: https://<домен>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- TikTok через Upload-Post (необязательно) ----
UPLOAD_POST_API_KEY=

# ---- email-уведомления ----
# пример: smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=SMM Admin <noreply@example.com>
NOTIFY_EMAILS=owner@example.com
CATCHUP_WINDOW_MIN=30
