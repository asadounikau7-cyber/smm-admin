generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  OPERATOR
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
}

enum AssetKind {
  FULL_EPISODE
  VERTICAL
  TEASER
  COVER
  SUBTITLES
}

enum PostFormat {
  YT_VIDEO
  YT_SHORT
  IG_REEL
  TT_VIDEO
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum TikTokMode {
  MANUAL
  PARTNER
}

enum PlanStatus {
  DRAFT
  APPROVED
}

enum JobStatus {
  DRAFT
  BLOCKED
  QUEUED
  SENT
  PROCESSING
  PUBLISHED
  ACTION_REQUIRED
  MANUALLY_SCHEDULED
  FAILED
  CANCEL_PENDING
  CANCELLED
  UNKNOWN
}

enum SeriesStage {
  NEW
  TESTING
  IN_WORK
  TEST_FAILED
}

enum AccountStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISABLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())
  audit        AuditEvent[]
}

model Series {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  /// Episode count announced by the source catalog
  expectedEpisodes Int?
  /// Off by default so 600+ imported series don't flood the weekly plan
  active    Boolean   @default(false)
  synopsis  String?
  hashtags  String?
  /// Banned / Inactive: shown in red everywhere, excluded from plans and new versions
  bannedAt  DateTime?
  banReason String?
  /// YouTube test: upload a version to the test channel, then on success the whole series goes "in work"
  stage         SeriesStage @default(NEW)
  testJobId     String?
  testNote      String?
  /// First time the test upload was seen live on YouTube; the check window counts from here
  testLiveAt    DateTime?
  testCheckedAt DateTime?
  inWorkAt      DateTime?
  launchJobId   String?
  createdAt DateTime  @default(now())
  episodes  Episode[]
  assets    Asset[]
  rules     ReleaseRule[]
  variants  VideoVariant[]
}

model Episode {
  id       String  @id @default(cuid())
  seriesId String
  series   Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  season   Int
  number   Int
  title    String?
  /// Manual upload to the main YouTube channel (until the API project passes Google's audit)
  mainUrl      String?
  mainPostedAt DateTime?
  assets   Asset[]
  variants VideoVariant[]

  @@unique([seriesId, season, number])
}

/// One object key in B2. Versions live in AssetVersion.
model Asset {
  id            String         @id @default(cuid())
  objectKey     String         @unique
  /// Direct public download URL (public bucket / catalog registry); used when no S3 key is configured
  publicUrl     String?
  seriesId      String?
  series        Series?        @relation(fields: [seriesId], references: [id])
  episodeId     String?
  episode       Episode?       @relation(fields: [episodeId], references: [id])
  kind          AssetKind?
  language      String?
  variant       String?
  needsMapping  Boolean        @default(true)
  rightsConfirmed Boolean      @default(false)
  deletedAt     DateTime?
  /// Set when this asset is the rendered file of an edited version (not a source from B2)
  renderOfId    String?        @unique
  renderOf      VideoVariant?  @relation("RenderOutput", fields: [renderOfId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  versions      AssetVersion[]
  variantsFrom  VideoVariant[] @relation("VariantSource")
}

model AssetVersion {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// B2 version id when available, else ETag
  versionKey  String
  etag        String?
  size        BigInt
  lastModified DateTime
  isCurrent   Boolean   @default(true)
  probedAt    DateTime?
  durationSec Float?
  width       Int?
  height      Int?
  videoCodec  String?
  audioCodec  String?
  probeError  String?
  createdAt   DateTime  @default(now())
  jobs        PublicationJob[]
  variantsFrom VideoVariant[] @relation("VariantSourceVersion")

  @@unique([assetId, versionKey])
}

model SocialAccount {
  id             String        @id @default(cuid())
  platform       Platform
  /// Stable platform id: YouTube channel id, IG user id, TikTok handle in manual mode
  externalId     String
  handle         String
  displayName    String?
  language       String?
  status         AccountStatus @default(ACTIVE)
  tiktokMode     TikTokMode?
  /// AES-GCM encrypted JSON with tokens
  credentials    String?
  /// Octo Browser profile the account is logged in under (manual posting / checks happen there)
  octoProfileId  String?
  octoProfile    OctoProfile?  @relation(fields: [octoProfileId], references: [id], onDelete: SetNull)
  variants       VideoVariant[]
  tokenExpiresAt DateTime?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime      @default(now())
  rules          ReleaseRule[]
  jobs           PublicationJob[]

  @@unique([platform, externalId])
}

model ReleaseRule {
  id              String      @id @default(cuid())
  name            String
  enabled         Boolean     @default(true)
  seriesId        String
  series          Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  assetKind       AssetKind
  language        String
  accountId       String
  account         SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  format          PostFormat
  visibility      Visibility  @default(PUBLIC)
  timezone        String      @default("America/Winnipeg")
  /// e.g. [{"weekday":2,"time":"19:00"},{"weekday":4,"time":"19:00"}] (1=Mon..7=Sun)
  slots           Json
  /// When set, the post goes this many minutes relative to the full-episode release of the same episode (negative = before)
  offsetMinutes   Int?
  offsetFromRuleId String?
  captionTemplate String      @default("{title} — S{season}E{episode}\n{cta}\n{hashtags}")
  cta             String?
  hashtags        String?
  strictOrder     Boolean     @default(true)
  /// Publish only the first N episodes of the series (teaser channel); null = all.
  maxEpisodes     Int?
  /// Publish only the account's own edited version of each episode (block when there is none)
  requireVariant  Boolean     @default(false)
  madeForKids     Boolean     @default(false)
  aiDisclosure    Boolean     @default(false)
  paidPromotion   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  jobs            PublicationJob[]
}

model WeeklyPlan {
  id          String     @id @default(cuid())
  /// Monday 00:00 in base timezone, stored as UTC
  weekStart   DateTime
  timezone    String
  status      PlanStatus @default(DRAFT)
  approvedAt  DateTime?
  approvedById String?
  approveKey  String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  jobs        PublicationJob[]

  @@unique([weekStart])
}

model PublicationJob {
  id             String     @id @default(cuid())
  planId         String
  plan           WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ruleId         String?
  rule           ReleaseRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  accountId      String
  account        SocialAccount @relation(fields: [accountId], references: [id])
  assetVersionId String?
  assetVersion   AssetVersion? @relation(fields: [assetVersionId], references: [id])
  coverKey       String?
  platform       Platform
  format         PostFormat
  visibility     Visibility
  /// Stable identity of "this publication on this account": rule + episode/teaser + slot
  instanceKey    String
  status         JobStatus  @default(DRAFT)
  blockReasons   Json?
  /// Manual edits in the draft survive a rebuild
  manualEdit     Boolean    @default(false)
  excluded       Boolean    @default(false)
  scheduledAt    DateTime
  localTime      String
  timezone       String
  deadlineAt     DateTime
  caption        String
  title          String?
  meta           Json?
  idempotencyKey String     @unique
  externalId     String?
  externalUrl    String?
  errorCode      String?
  errorMessage   String?
  leaseUntil     DateTime?
  attemptCount   Int        @default(0)
  nextAttemptAt  DateTime?
  rowVersion     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  attempts       PublicationAttempt[]

  @@unique([accountId, instanceKey])
  @@index([status, scheduledAt])
}

model PublicationAttempt {
  id         String   @id @default(cuid())
  jobId      String
  job        PublicationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  step       String
  ok         Boolean?
  httpStatus Int?
  errorCode  String?
  message    String?
  state      Json?
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  /// Dedup key: same problem on the same object is merged
  dedupKey  String   @unique
  kind      String
  message   String
  link      String?
  count     Int      @default(1)
  sentAt    DateTime?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value Json
}

/// An Octo Browser profile on the owner's computer. Variant A: Octo runs there, an agent relays commands.
model OctoProfile {
  id        String          @id @default(cuid())
  title     String
  /// Profile UUID in Octo (needed only for API control, Base plan and above)
  octoUuid  String?         @unique
  proxyNote String?
  notes     String?
  /// Last state reported by the agent
  running   Boolean         @default(false)
  lastSeenAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  accounts  SocialAccount[]
  commands  AgentCommand[]
}

enum AgentCommandType {
  START_PROFILE
  STOP_PROFILE
  LIST_PROFILES
}

enum AgentCommandStatus {
  PENDING
  TAKEN
  DONE
  FAILED
}

/// Commands the admin queues for the agent on the owner's computer; the agent polls over HTTPS.
model AgentCommand {
  id         String             @id @default(cuid())
  type       AgentCommandType
  profileId  String?
  profile    OctoProfile?       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Page to open after the profile starts
  url        String?
  status     AgentCommandStatus @default(PENDING)
  result     Json?
  error      String?
  createdById String?
  takenAt    DateTime?
  doneAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([status, createdAt])
}

/// Editing template: a base recipe plus the ranges that make each generated version different.
model EditTemplate {
  id          String         @id @default(cuid())
  name        String
  notes       String?
  recipe      Json
  variation   Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  variants    VideoVariant[]
}

enum VariantStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

/// One edited version of one episode. Rendered from the untouched source by its recipe; given to at most one account.
model VideoVariant {
  id              String        @id @default(cuid())
  /// Human code, e.g. 639846-S01E03-EN-V017
  code            String        @unique
  number          Int
  language        String
  seriesId        String
  series          Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodeId       String
  episode         Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sourceAssetId   String
  sourceAsset     Asset         @relation("VariantSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  sourceVersionId String
  sourceVersion   AssetVersion  @relation("VariantSourceVersion", fields: [sourceVersionId], references: [id], onDelete: Cascade)
  templateId      String?
  template        EditTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipe          Json
  /// Hash of the normalized recipe: two versions of one episode can't be identical
  signature       String
  accountId       String?
  account         SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status          VariantStatus @default(PENDING)
  renderer        String?
  leaseUntil      DateTime?
  attempts        Int           @default(0)
  error           String?
  renderedAt      DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  output          Asset?        @relation("RenderOutput")

  @@unique([episodeId, accountId])
  @@unique([episodeId, signature])
  @@index([status, createdAt])
}
